# ---- Database ----
DB_NAME=penoks
DB_USER=penoks_admin
DB_PASSWORD=change_this_strong_password

# ---- App / Auth ----
JWT_SECRET=change_this_to_a_long_random_string
# set to true once you serve over HTTPS
COOKIE_SECURE=false

# Public address of the portal. Used to build the password-reset links that are
# emailed to members (no trailing slash). Leave blank to auto-detect from the request.
APP_BASE_URL=

# First admin account, created automatically on first boot
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_admin_password

# ---- Contact form email (SMTP) ----
# Any SMTP provider works: Gmail (with an App Password), SendGrid, Mailgun,
# Amazon SES, your own mail server, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true if using port 465
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
CONTACT_FROM_EMAIL=no-reply@penoksa.me
CONTACT_TO_EMAIL=contact@penoksa.me

# ---- Google Sheets live sync (for automations) ----
# ID of a Google Sheet (the long string in its URL) shared with the service account
# as Editor. Leave blank to disable. See docs/AUTOMATION_GUIDE.md
GSHEET_ID=
# every 30 minutes
SHEETS_SYNC_CRON=*/30 * * * *

# ---- Google Drive / Sheets backup ----
# ID of the destination folder in Google Drive (share it with the
# service account's client_email as an Editor first). Leave blank to
# skip uploading and just keep local backups in the backup_tmp volume.
GDRIVE_FOLDER_ID=

# Cron schedules (5-field crontab syntax, container's local time is UTC)
DB_BACKUP_CRON=0 2 * * *
ACCOUNTS_EXPORT_CRON=0 3 * * *
